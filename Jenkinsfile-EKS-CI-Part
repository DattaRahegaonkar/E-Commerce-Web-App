pipeline {
    agent any

    stages {

        stage("Cleaning") {
            steps {
                deleteDir()
            }
        }

        stage("Cloning") {
            steps {
                git url: "https://github.com/DattaRahegaonkar/E-Commerce-Web-App.git", branch: "main"
            }
        }

        stage("Building Docker Images") {
            steps {
                sh '''
                docker build -t ecommerce-app-backend:v${BUILD_NUMBER} Backend/
                docker build -t ecommerce-app-frontend:v${BUILD_NUMBER} Frontend/
                '''
            }
        }

        stage("Tagging Docker Images") {
            steps {
                sh '''
                docker tag ecommerce-app-backend:v${BUILD_NUMBER} dattarahegaonkar09/ecommerce-app-backend:v${BUILD_NUMBER}
                docker tag ecommerce-app-frontend:v${BUILD_NUMBER} dattarahegaonkar09/ecommerce-app-frontend:v${BUILD_NUMBER}
                '''
            }
        }

        stage("Pushing Docker Images") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                    echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin

                    docker push dattarahegaonkar09/ecommerce-app-backend:v${BUILD_NUMBER}
                    docker push dattarahegaonkar09/ecommerce-app-frontend:v${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage("Delete Previous Images") { 
            steps { 
                sh '''
                echo "Deleting previous Docker images from Jenkins machine..."
                
                PREVIOUS_BUILD=$((BUILD_NUMBER - 1))

                docker rmi ecommerce-app-backend:v${PREVIOUS_BUILD} || true
                docker rmi ecommerce-app-frontend:v${PREVIOUS_BUILD} || true

                docker rmi dattarahegaonkar09/ecommerce-app-backend:v${PREVIOUS_BUILD} || true
                docker rmi dattarahegaonkar09/ecommerce-app-frontend:v${PREVIOUS_BUILD} || true

                echo "Previous build images deleted from Jenkins machine."
                '''
            }
        }
    }
}
